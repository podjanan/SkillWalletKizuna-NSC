# ============================================================
# Skill Wallet Kizuna - CMS/API production environment example
# Copy this file to .env and replace every change-me value.
# Never commit the real .env file.
#
# POSTGRES_PASSWORD is interpolated into a connection URL by Docker Compose.
# Use a long URL-safe value containing letters, numbers, hyphens or underscores.
# ============================================================

# Public application URLs
NEXT_PUBLIC_APP_URL=https://api.example.com
NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api

# Better Auth
BETTER_AUTH_URL=https://api.example.com
BETTER_AUTH_TRUSTED_ORIGIN=https://api.example.com
BETTER_AUTH_INTERNAL_URL=http://app:3000
INTERNAL_AUTH_URL=http://app:3000
API_SECRET_KEY=change-me-to-a-long-random-api-key

# PostgreSQL (Docker Compose uses the db service on port 5432)
POSTGRES_DB=skillwallet
POSTGRES_USER=skillwallet_user
POSTGRES_PASSWORD=change-me-to-a-long-url-safe-password
DATABASE_URL=postgresql://skillwallet_user:change-me-to-a-long-url-safe-password@db:5432/skillwallet
DIRECT_URL=postgresql://skillwallet_user:change-me-to-a-long-url-safe-password@db:5432/skillwallet

# pgAdmin
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me-to-a-strong-pgadmin-password

# MinIO object storage
MINIO_INTERNAL_URL=http://minio:9000
MINIO_PUBLIC_URL=https://api.example.com/api/media
MINIO_BUCKET=avatars
MINIO_ACCESS_KEY=change-me-minio-user
MINIO_SECRET_KEY=change-me-to-a-long-minio-secret

# Ollama
# Docker default: http://ollama:11434
# Remote AI over Tailscale example: http://100.64.0.10:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_VISION_MODEL=gemma3:4b
OLLAMA_KEEP_ALIVE=1m

# Speech-to-text
WHISPER_MODE=local
WHISPER_LOCAL_URL=http://whisper:8000
# GROQ_API_KEY=

# Object detection / handwriting
OBJECT_DETECTION_URL=http://yolo-detector:8000/detect
OBJECT_DETECTION_MIN_CONFIDENCE=0.18
OBJECT_DETECTION_MAX_OBJECTS=20
OBJECT_DETECTION_TIMEOUT_MS=20000
# HANDWRITING_OCR_URL=
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash

# YOLO container
YOLO_MODEL=yolov8s-worldv2.pt
YOLO_CONFIDENCE=0.18
YOLO_IMAGE_SIZE=640
YOLO_IOU_THRESHOLD=0.45
YOLO_MAX_OBJECTS=20
YOLO_MAX_DETECTIONS=100
# Leave blank to use the classes configured in docker-compose.yml.
# YOLO_CLASSES=

# Optional social login
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# Optional Supabase compatibility
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Sing Together / Suno provider
USE_GOAPI=false
# SUNO_API_KEY=
SUNO_API_URL=https://api.goapi.ai/suno/v1/music

# Optional local story-background service. Leave blank to use the
# deterministic renderer.
LOCAL_IMAGE_URL=
